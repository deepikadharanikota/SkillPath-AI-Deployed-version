# ══════════════════════════════════════════════════════════════════════════════
# SkillPath AI — Environment Variables Template
# ══════════════════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────────────────────
# FRONTEND VARIABLES (Set in Vercel Project Settings > Environment Variables)
# ──────────────────────────────────────────────────────────────────────────────

# Render Backend URL (Public HTTPS URL of your deployed Render FastAPI service)
VITE_API_URL=https://skillpath-ai-backend.onrender.com

# Supabase Public Configuration (from Supabase Dashboard > Project Settings > API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ──────────────────────────────────────────────────────────────────────────────
# BACKEND VARIABLES (Set in Render Dashboard > Environment)
# ──────────────────────────────────────────────────────────────────────────────

# Supabase PostgreSQL Connection String (Transaction Pooler or Direct connection)
# Found in Supabase Dashboard > Project Settings > Database > Connection string > URI
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Supabase Project Credentials (from Supabase Dashboard > Project Settings > API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Groq API Key (from https://console.groq.com/keys)
GROQ_API_KEY=your-groq-api-key

# Frontend URL (for CORS and redirects)
FRONTEND_URL=https://skillpath-ai.vercel.app
ALLOWED_ORIGINS=https://skillpath-ai.vercel.app

# Application Secret Key
SECRET_KEY=supersecretkey_replace_with_random_string

# Optional: GitHub OAuth (if using GitHub SSO directly)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
