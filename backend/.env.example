# ══════════════════════════════════════════════════════════════════════════════
# SkillPath AI Backend Environment Variables (Render)
# ══════════════════════════════════════════════════════════════════════════════

# Database Connection (Supabase PostgreSQL pooler or direct connection URI)
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# Supabase Project API & Storage
# Found in Supabase Dashboard > Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Groq API Key (for LLM-powered curriculum insights and personalized quiz generation)
# Found at https://console.groq.com/keys
GROQ_API_KEY=

# Production Frontend Origin (Vercel deployment URL)
# Example: https://skillpath-ai.vercel.app
FRONTEND_URL=
ALLOWED_ORIGINS=

# Optional: Session encryption key (automatically generated on Render if omitted)
SECRET_KEY=

# Optional: GitHub OAuth (if using direct GitHub SSO)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
