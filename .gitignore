# ══════════════════════════════════════════════════════════════════════════════
# SkillPath AI — Deployment .gitignore
# ══════════════════════════════════════════════════════════════════════════════

# Node.js & Frontend builds
node_modules/
frontend/node_modules/
dist/
frontend/dist/
.npm/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.bak

# Scratch scripts
scratch/

# C extensions
*.so

# Environment variables & secrets
.env
.env.*
!.env.example
*.pem
*.key

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# Distribution / packaging
build/
*.egg-info/
*.egg

# IDEs & Editor configurations
.vscode/
.idea/
*.swp
*.swo
*~

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Uploaded user files & runtime data
backend/uploads/*
!backend/uploads/.gitkeep
backend/*.log
*.log

# Database, Redis & Docker runtime persistence
*.sqlite3
*.db
dump.rdb
postgres_data/
redis_data/

# Temporary test weight files (keep production weights dqn_weights.pkl)
backend/test_*.pkl
